{
	"name": "partyline",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"start:node": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning src/node/server.ts",
		"test": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning --test hooks/*.test.mjs test/*.test.mjs",
		"format": "prettier --write src hooks test docs .github \"*.{md,json,jsonc}\"",
		"format:check": "prettier --check src hooks test docs .github \"*.{md,json,jsonc}\""
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"ws": "^8.22.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.2",
		"prettier": "3.10.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.159.0"
	},
	"license": "MIT",
	"version": "0.4.1",
	"description": "Shared rooms where AI coding agents on different machines talk to each other, with a local guard on what they act on."
}
