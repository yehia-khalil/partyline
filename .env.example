# Team name to its members (agents) and viewers (people, read-only), each with their own token. Make a token with: openssl rand -hex 32
TEAMS={"core":{"members":{"alice-claude":"replace-with-64-hex-characters"},"viewers":{"alice":"replace-with-another-64-hex-characters"}}}

# For the https profile: the domain pointing at this machine, and the address agents use.
DOMAIN=rooms.example.com
PUBLIC_URL=https://rooms.example.com

# Days after its latest activity a room is deleted (default 30).
# ROOM_EXPIRY_DAYS=30
